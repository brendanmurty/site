{% import "components/info.njk" as info %}

{% macro card(post) %}
{% set summary = post.content | md | striptags | truncate(120) %}
<li class="post-card">
  <a class="post-card-link" href="{{ post.url }}">
    <span class="post-card-title">{{ post.title }}</span>
    {% if summary %}<span class="post-card-summary">{{ summary | safe }}</span>{% endif %}
  </a>
  <div class="post-details">
    {{ info.post(post.date, post.readingInfo.words) }}
  </div>
</li>
{% endmacro %}
